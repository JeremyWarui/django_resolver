# Database Configuration (Neon PostgreSQL)
DB_NAME="your-db-name"
DB_USER="your-db-user"
DB_PASSWORD="your-db-password"
DB_HOST="your-neon-host.neon.tech"
DB_PORT="5432"

# Django Settings
SECRET_KEY='your-secret-key-here'
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Email Configuration (Optional - for magic link auth if enabled)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-gmail@gmail.com

# CORS Configuration (for frontend)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Web Push (PWA push notifications) — generate with: python -c "from pywebpush import Vapid; v=Vapid(); v.generate_keys(); print('PRIVATE:', v.private_pem().decode()); print('PUBLIC:', v.public_key)"
# Keys must be base64url-encoded. Leave blank to disable push notifications (they will silently no-op).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@resolver.local

# Production Settings (Render)
# DEBUG=False
# ALLOWED_HOSTS=your-app-name.onrender.com,127.0.0.1,localhost
