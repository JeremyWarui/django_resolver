### Django Resolver API Test Suite
### REST Client file for manual API testing
### Usage: Install REST Client extension in VS Code, then click "Send Request" above each request

# Configuration
@baseUrl = http://localhost:8000
@contentType = application/json

### Variables for tokens (will be set after login)
# @userToken = your_token_here
# @technicianToken = your_token_here
# @managerToken = your_token_here
# @adminToken = your_token_here

################################################################################
# AUTHENTICATION & USER MANAGEMENT
################################################################################

### 1. Login as User (regular user who creates tickets)
# Fixture data: username: testuser, password: testpass123
POST {{baseUrl}}/api/auth/login/
Content-Type: {{contentType}}

{
  "username": "testuser",
  "password": "testpass123"
}

### 2. Login as Technician (can be assigned tickets, update status)
# Get technician credentials from fixture data
POST {{baseUrl}}/api/auth/login/
Content-Type: {{contentType}}

{
  "username": "technician_username",
  "password": "tech_password"
}

### 3. Login as Manager (full access except some admin tasks)
POST {{baseUrl}}/api/auth/login/
Content-Type: {{contentType}}

{
  "username": "manager_username",
  "password": "manager_password"
}

### 4. Login as Admin (full system access)
POST {{baseUrl}}/api/auth/login/
Content-Type: {{contentType}}

{
  "username": "admin_username",
  "password": "admin_password"
}

### 5. Get Current User Profile
GET {{baseUrl}}/api/users/me/
Authorization: Bearer {{userToken}}

### 6. List All Users (admin/manager only)
GET {{baseUrl}}/api/users/
Authorization: Bearer {{adminToken}}

### 7. Create New User (admin only)
POST {{baseUrl}}/api/users/
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "first_name": "Jane",
  "last_name": "Smith",
  "email": "jane.smith@example.com",
  "password": "securepass123",
  "role": "user",
  "sections": []
}

################################################################################
# SECTIONS & FACILITIES
################################################################################

### 8. List All Sections
GET {{baseUrl}}/api/sections/
Authorization: Bearer {{userToken}}

### 9. List All Facilities
GET {{baseUrl}}/api/facilities/
Authorization: Bearer {{userToken}}

### 10. Get Technicians by Section (for assignment)
GET {{baseUrl}}/api/technicians/?section_id=1
Authorization: Bearer {{managerToken}}

################################################################################
# TICKET CREATION & MANAGEMENT
################################################################################

### 11. Create New Ticket (User)
POST {{baseUrl}}/api/tickets/
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "title": "Broken AC in Conference Room",
  "description": "The air conditioning unit in Conference Room B has stopped working. Room temperature is rising.",
  "section_id": 1,
  "facility_id": 1
}

### 12. List All Tickets
GET {{baseUrl}}/api/tickets/
Authorization: Bearer {{userToken}}

### 13. Filter Tickets - Unassigned Only
GET {{baseUrl}}/api/tickets/?assigned_to__isnull=true
Authorization: Bearer {{managerToken}}

### 14. Filter Tickets - By Status
GET {{baseUrl}}/api/tickets/?status=open
Authorization: Bearer {{technicianToken}}

### 15. Filter Tickets - Overdue Tickets
GET {{baseUrl}}/api/tickets/?is_overdue=true
Authorization: Bearer {{managerToken}}

### 16. Filter Tickets - By Section and Status
GET {{baseUrl}}/api/tickets/?section=1&status=assigned
Authorization: Bearer {{technicianToken}}

### 17. Get Single Ticket Details
# Replace {id} with actual ticket ID
GET {{baseUrl}}/api/tickets/1/
Authorization: Bearer {{userToken}}

### 18. Search Tickets by Title
GET {{baseUrl}}/api/tickets/?search=AC
Authorization: Bearer {{userToken}}

################################################################################
# TICKET ASSIGNMENT (Manager/Admin)
################################################################################

### 19. Assign Ticket to Technician
# Replace {id} with actual ticket ID
# Technician must belong to ticket's section
PATCH {{baseUrl}}/api/tickets/1/
Content-Type: {{contentType}}
Authorization: Bearer {{managerToken}}

{
  "assigned_to": 2,
  "status": "assigned"
}

### 20. Reassign Ticket to Another Technician
PATCH {{baseUrl}}/api/tickets/1/
Content-Type: {{contentType}}
Authorization: Bearer {{managerToken}}

{
  "assigned_to": 3
}

################################################################################
# TICKET STATUS UPDATES (Technician)
################################################################################

### 21. Update Status: Assigned → In Progress
PATCH {{baseUrl}}/api/tickets/1/
Content-Type: {{contentType}}
Authorization: Bearer {{technicianToken}}

{
  "status": "in_progress"
}

### 22. Update Status: In Progress → Pending (with reason)
PATCH {{baseUrl}}/api/tickets/1/
Content-Type: {{contentType}}
Authorization: Bearer {{technicianToken}}

{
  "status": "pending",
  "pending_reason": "Waiting for replacement parts to arrive"
}

### 23. Update Status: Pending → In Progress (resume work)
PATCH {{baseUrl}}/api/tickets/1/
Content-Type: {{contentType}}
Authorization: Bearer {{technicianToken}}

{
  "status": "in_progress"
}

### 24. Update Status: In Progress → Resolved
PATCH {{baseUrl}}/api/tickets/1/
Content-Type: {{contentType}}
Authorization: Bearer {{technicianToken}}

{
  "status": "resolved",
  "resolution_notes": "Replaced faulty compressor unit. AC is now working properly."
}

### 25. Update Status: Resolved → Closed (Admin/Manager only)
PATCH {{baseUrl}}/api/tickets/1/
Content-Type: {{contentType}}
Authorization: Bearer {{managerToken}}

{
  "status": "closed"
}

################################################################################
# COMMENTS
################################################################################

### 26. Add Comment to Ticket (User)
POST {{baseUrl}}/api/comments/
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "ticket": 1,
  "text": "The room is getting very hot. This is urgent!"
}

### 27. Add Comment (Technician)
POST {{baseUrl}}/api/comments/
Content-Type: {{contentType}}
Authorization: Bearer {{technicianToken}}

{
  "ticket": 1,
  "text": "I've inspected the unit. The compressor appears to be faulty. Ordering replacement parts."
}

### 28. Add Comment (Manager)
POST {{baseUrl}}/api/comments/
Content-Type: {{contentType}}
Authorization: Bearer {{managerToken}}

{
  "ticket": 1,
  "text": "Priority ticket. Please expedite the repair."
}

### 29. Get All Comments for a Ticket
GET {{baseUrl}}/api/comments/?ticket=1
Authorization: Bearer {{userToken}}

### 30. Update Comment
# Replace {id} with actual comment ID
PATCH {{baseUrl}}/api/comments/1/
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "text": "Updated: The room temperature is now 32°C. This is urgent!"
}

### 31. Delete Comment
# Replace {id} with actual comment ID
DELETE {{baseUrl}}/api/comments/1/
Authorization: Bearer {{userToken}}

################################################################################
# FEEDBACK (Only on Resolved/Closed Tickets)
################################################################################

### 32. Submit Feedback on Resolved Ticket (User)
POST {{baseUrl}}/api/feedback/
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "ticket": 1,
  "rating": 5,
  "comment": "Excellent service! The technician was professional and fixed the issue quickly."
}

### 33. Submit Feedback with Lower Rating
POST {{baseUrl}}/api/feedback/
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "ticket": 2,
  "rating": 3,
  "comment": "Issue resolved but took longer than expected."
}

### 34. Get All Feedback
GET {{baseUrl}}/api/feedback/
Authorization: Bearer {{managerToken}}

### 35. Get Feedback for Specific Ticket
GET {{baseUrl}}/api/feedback/?ticket=1
Authorization: Bearer {{userToken}}

### 36. Update Feedback
# Replace {id} with actual feedback ID
PATCH {{baseUrl}}/api/feedback/1/
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "rating": 4,
  "comment": "Updated: Good service overall, minor delays."
}

################################################################################
# ANALYTICS
################################################################################

### 37. Admin Dashboard (Overview)
GET {{baseUrl}}/api/analytics/admin-dashboard/
Authorization: Bearer {{adminToken}}

### 38. Ticket Analytics - Weekly Summary
GET {{baseUrl}}/api/analytics/tickets/?timeframe=week
Authorization: Bearer {{managerToken}}

### 39. Ticket Analytics - Monthly by Section
GET {{baseUrl}}/api/analytics/tickets/?timeframe=month&section_id=1
Authorization: Bearer {{managerToken}}

### 40. Ticket Analytics - Last 30 Days Grouped by Day
GET {{baseUrl}}/api/analytics/tickets/?days=30&group_by=day
Authorization: Bearer {{managerToken}}

### 41. Ticket Analytics - By Facility
GET {{baseUrl}}/api/analytics/tickets/?facility_id=1&timeframe=month
Authorization: Bearer {{managerToken}}

### 42. Technician Performance Analytics
GET {{baseUrl}}/api/analytics/technicians/?technician_id=2
Authorization: Bearer {{managerToken}}

### 43. Section Performance Analytics
GET {{baseUrl}}/api/analytics/tickets/?section_id=1&timeframe=month
Authorization: Bearer {{managerToken}}

################################################################################
# REPORTS
################################################################################

### 44. List Available Report Types
GET {{baseUrl}}/api/reports/types/
Authorization: Bearer {{managerToken}}

### 45. Generate PDF Report - All Open Tickets
GET {{baseUrl}}/api/reports/generate/?report_type=tickets&format=pdf&status=open
Authorization: Bearer {{managerToken}}

### 46. Generate CSV Report - Resolved Tickets
GET {{baseUrl}}/api/reports/generate/?report_type=tickets&format=csv&status=resolved
Authorization: Bearer {{managerToken}}

### 47. Generate Technician Performance Report
GET {{baseUrl}}/api/reports/generate/?report_type=technicians&format=pdf&technician_id=2
Authorization: Bearer {{adminToken}}

################################################################################
# COMPLETE WORKFLOW EXAMPLE
################################################################################

### WORKFLOW 1: User Creates Ticket → Manager Assigns → Technician Resolves → User Provides Feedback

# Step 1: User creates a ticket
POST {{baseUrl}}/api/tickets/
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "title": "Leaking Pipe in Bathroom",
  "description": "There's a leak under the sink in the 2nd floor bathroom",
  "section_id": 2,
  "facility_id": 1
}

###
# Step 2: Manager views unassigned tickets
GET {{baseUrl}}/api/tickets/?assigned_to__isnull=true&status=open
Authorization: Bearer {{managerToken}}

###
# Step 3: Manager assigns to technician (use ticket ID from step 1)
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Bearer {{managerToken}}

{
  "assigned_to": 2
}

###
# Step 4: Technician starts work
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Bearer {{technicianToken}}

{
  "status": "in_progress"
}

###
# Step 5: Technician adds comment
POST {{baseUrl}}/api/comments/
Content-Type: {{contentType}}
Authorization: Bearer {{technicianToken}}

{
  "ticket": "{ticket_id}",
  "text": "Located the leak. Replacing the worn-out pipe fitting."
}

###
# Step 6: Technician resolves ticket
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Bearer {{technicianToken}}

{
  "status": "resolved",
  "resolution_notes": "Replaced pipe fitting. Leak fixed. Tested for 30 minutes, no leaks detected."
}

###
# Step 7: User provides feedback
POST {{baseUrl}}/api/feedback/
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "ticket": "{ticket_id}",
  "rating": 5,
  "comment": "Quick response and professional work. Thank you!"
}

###
# Step 8: Manager closes ticket
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Bearer {{managerToken}}

{
  "status": "closed"
}

################################################################################
# WORKFLOW 2: Pending Status Workflow
################################################################################

### Scenario: Technician needs parts, puts ticket on pending

# Step 1: Technician marks as pending
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Bearer {{technicianToken}}

{
  "status": "pending",
  "pending_reason": "Waiting for specialized tool from equipment room"
}

###
# Step 2: User adds comment asking for update
POST {{baseUrl}}/api/comments/
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "ticket": "{ticket_id}",
  "text": "Any update on when this will be completed?"
}

###
# Step 3: Technician responds
POST {{baseUrl}}/api/comments/
Content-Type: {{contentType}}
Authorization: Bearer {{technicianToken}}

{
  "ticket": "{ticket_id}",
  "text": "Parts arrived. Will resume work tomorrow morning."
}

###
# Step 4: Technician resumes work
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Bearer {{technicianToken}}

{
  "status": "in_progress"
}

################################################################################
# ERROR SCENARIOS (Testing Validation)
################################################################################

### ERROR 1: Try to assign ticket to technician from wrong section
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Bearer {{managerToken}}

{
  "assigned_to": 99
}

### ERROR 2: Try to submit feedback on unresolved ticket
POST {{baseUrl}}/api/feedback/
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "ticket": "{open_ticket_id}",
  "rating": 5,
  "comment": "This should fail"
}

### ERROR 3: Try invalid status transition (open → resolved)
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Bearer {{technicianToken}}

{
  "status": "resolved"
}

### ERROR 4: User tries to assign ticket (permission denied)
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "assigned_to": 2
}

### ERROR 5: Try to modify closed ticket
PATCH {{baseUrl}}/api/tickets/{closed_ticket_id}/
Content-Type: {{contentType}}
Authorization: Bearer {{technicianToken}}

{
  "status": "open"
}

################################################################################
# NOTES
################################################################################

# Before running these tests:
# 1. Start the Django development server: python manage.py runserver
# 2. Load fixture data: python manage.py loaddata tickets/fixtures/tickets_initial_data.json
# 3. Update the authentication tokens after logging in
# 4. Replace {ticket_id}, {user_id}, etc. with actual IDs from responses
# 5. Install REST Client extension in VS Code

# Authentication Options:
# - If using DRF Token Auth: Authorization: Token your_token_here
# - If using JWT: Authorization: Bearer your_jwt_token_here
# - If using Session Auth: Include CSRF token and session cookie

# Tips:
# - Use variables (@ syntax) to store tokens and reuse them
# - Click "Send Request" link above each request to execute
# - View responses in the right panel
# - Use Ctrl+Alt+E (Windows/Linux) or Cmd+Alt+E (Mac) to send requests
