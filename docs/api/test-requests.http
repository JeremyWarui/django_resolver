PATCH {{baseUrl}}/api/tickets/{closed_ticket_id}/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "status": "open"
}

################################################################################
# NOTES & SETUP
################################################################################

# Before running these tests:
# 1. Start the Django development server: python manage.py runserver
# 2. Load fixture data: python manage.py loaddata tickets/fixtures/tickets_initial_data_org.json
# 3. Get tokens by posting to /api/auth/login/ for each role and copying the token here:
#      @adminToken       — role: admin
#      @userToken        — role: user
#      @technicianToken  — role: technician
#      @hodToken         — role: hod
#      @directorToken    — role: director
#      @sectionHeadToken — role: section_head
# 4. Replace {ticket_id}, {user_id}, etc. with actual IDs from responses
# 5. Install REST Client extension in VS Code
#
# ORGANIZATION HIERARCHY ENDPOINTS:
#   GET/POST  /api/organizations/         — list + create (create: admin only)
#   GET/PATCH/DELETE  /api/organizations/{id}/   — read (scoped) + write (admin only)
#   GET/POST  /api/campuses/              — list (scoped by role) + create (admin only)
#   GET/PATCH/DELETE  /api/campuses/{id}/        — read (scoped) + write (admin only)
#   GET/POST  /api/departments/           — list (scoped by role) + create (admin only)
#   GET/PATCH/DELETE  /api/departments/{id}/     — read (scoped) + write (admin only)
#
# Scope by role (list endpoints):
#   admin       → all records
#   director    → all records within their organization
#   hod         → all departments on their campus; only their own campus
#   section_head/technician/user → only their own campus / department

# Using REST Client Extension:
# - Click "Send Request" link above each request to execute
# - View responses in the right panel
# - Results show status code, headers, and formatted JSON body
# - Use Ctrl+Alt+E (Windows/Linux) or Cmd+Alt+E (Mac) to send requests
# - Store tokens in @variable format at top to reuse across multiple requests

# Authentication:
# - DRF Token Auth format: Authorization: Token your_token_here
# - All endpoints require a valid token in the Authorization header
# - Get token from /api/auth/login/ endpoint by posting username + password

# ROLE-BASED FIELD STRIPPING:
# Serializers automatically strip fields the requesting role doesn't need:
#
#   FacilitySerializer
#     purchase_date, warranty_expiry, asset_value  →  hod / director / admin only
#
#   SectionSerializer
#     technicians                                  →  section_head / hod / admin only
#
#   TicketSerializer
#     available_technicians                        →  section_head / hod / admin only
#     escalated_to, escalated_at,
#     escalation_reason, next_escalation_due       →  all roles except: user (stripped)
#     organizational_path                          →  section_head / hod / director / admin only

# ESCALATION PRIORITY FEATURE:
# The new feature automatically sets ticket priority based on escalation level:
#   - Escalation Level 0 (no escalation) → priority = "low"
#   - Escalation Level 1 (escalated to section head) → priority = "medium"
#   - Escalation Level 2 (escalated to HOD) → priority = "high"
# 
# Test this feature using the "PRIORITY TEST 1-4" requests in the 
# "ESCALATION PRIORITY TESTS" section above.

# Troubleshooting:
# - 401 Unauthorized: Check token validity, re-login
# - 403 Forbidden: Check user permissions for the role
# - 404 Not Found: Verify ticket/comment ID exists in database
# - 400 Bad Request: Check request body format and required fields
