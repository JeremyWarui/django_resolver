### Django Resolver API Test Suite
### REST Client file for manual API testing
### Usage: Install REST Client extension in VS Code, then click "Send Request" above each request

# Configuration
@baseUrl = http://localhost:8000
@contentType = application/json

### Variables for tokens (update after login)
@adminToken = 091f78201d634c688abdb59bdded0008ce82abe2
@userToken = 
@technicianToken = 
@managerToken = 

### Test Credentials (from fixtures)
# Admin: admin_user / adminuser123
# Technician: tech_alex / alexsmith123
# User: jane_user / janedoe123
# Manager: manager_ben / benclark123

################################################################################
# AUTHENTICATION & USER MANAGEMENT
################################################################################

### 1. Login as User (regular user who creates tickets)
# Fixture data: username: testuser, password: testpass123
POST {{baseUrl}}/api/auth/login/
Content-Type: {{contentType}}

{
  "username": "testuser",
  "password": "testpass123"
}

### 2. Login as Technician (can be assigned tickets, update status)
# Get technician credentials from fixture data
POST {{baseUrl}}/api/auth/login/
Content-Type: {{contentType}}

{
  "username": "technician_username",
  "password": "tech_password"
}

### 3. Login as Manager (full access except some admin tasks)
POST {{baseUrl}}/api/auth/login/
Content-Type: {{contentType}}

{
  "username": "manager_username",
  "password": "manager_password"
}

### 4. Login as Admin (full system access)
POST {{baseUrl}}/api/auth/login/
Content-Type: {{contentType}}

{
  "username": "admin_username",
  "password": "admin_password"
}

################################################################################
# USER MANAGEMENT
################################################################################

### 5. Login as Admin Example
POST {{baseUrl}}/api/auth/login/
Content-Type: {{contentType}}

{
  "username": "admin_user",
  "password": "adminuser123"
}

### 6. Get Current User Profile
GET {{baseUrl}}/api/users/me/
Authorization: Token {{adminToken}}

### 7. List All Users (admin/manager only)
GET {{baseUrl}}/api/users/
Authorization: Token {{adminToken}}

### 8. Create New User (admin only)
POST {{baseUrl}}/api/users/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "first_name": "Jane",
  "last_name": "Smith",
  "email": "jane.smith@example.com",
  "password": "securepass123",
  "role": "user",
  "sections": []
}

################################################################################
# SECTIONS & FACILITIES
################################################################################

### 9. List All Sections
GET {{baseUrl}}/api/sections/
Authorization: Token {{adminToken}}

### 10. List All Facilities
GET {{baseUrl}}/api/facilities/
Authorization: Token {{adminToken}}

### 11. Get Technicians by Section (for assignment)
GET {{baseUrl}}/api/technicians/?section_id=1
Authorization: Token {{adminToken}}

################################################################################
# ESCALATION PRIORITY TESTS (Feature: Priority based on escalation level)
################################################################################

### PRIORITY TEST 1: Tickets at Escalation Level 0 (expect priority = "low")
GET {{baseUrl}}/api/tickets/?escalation_level=0&limit=2
Authorization: Token {{adminToken}}

###
### PRIORITY TEST 2: Tickets at Escalation Level 1 (expect priority = "medium")
GET {{baseUrl}}/api/tickets/?escalation_level=1&limit=2
Authorization: Token {{adminToken}}

###
### PRIORITY TEST 3: Tickets at Escalation Level 2 (expect priority = "high")
GET {{baseUrl}}/api/tickets/?escalation_level=2&limit=2
Authorization: Token {{adminToken}}

###
### PRIORITY TEST 4: Get single ticket details (verify priority matches escalation_level)
### Check response: priority field should be:
###   - "low" if escalation_level = 0
###   - "medium" if escalation_level = 1
###   - "high" if escalation_level = 2
GET {{baseUrl}}/api/tickets/1/
Authorization: Token {{adminToken}}

################################################################################
# TICKET CREATION & MANAGEMENT
################################################################################

### 12. Create New Ticket (User)
POST {{baseUrl}}/api/tickets/
Content-Type: {{contentType}}
Authorization: Token {{userToken}}

{
  "title": "Broken AC in Conference Room",
  "description": "The air conditioning unit in Conference Room B has stopped working. Room temperature is rising.",
  "section_id": 1,
  "facility_id": 1
}

### 13. List All Tickets
GET {{baseUrl}}/api/tickets/
Authorization: Token {{adminToken}}

### 14. Filter Tickets - Unassigned Only
GET {{baseUrl}}/api/tickets/?assigned_to__isnull=true
Authorization: Token {{adminToken}}

### 15. Filter Tickets - By Status
GET {{baseUrl}}/api/tickets/?status=open
Authorization: Token {{adminToken}}

### 16. Filter Tickets - Overdue Tickets
GET {{baseUrl}}/api/tickets/?is_overdue=true
Authorization: Token {{adminToken}}

### 17. Filter Tickets - By Section and Status
GET {{baseUrl}}/api/tickets/?section=1&status=assigned
Authorization: Token {{adminToken}}

### 18. Get Single Ticket Details
# Replace {id} with actual ticket ID
GET {{baseUrl}}/api/tickets/1/
Authorization: Token {{adminToken}}

### 19. Search Tickets by Title
GET {{baseUrl}}/api/tickets/?search=AC
Authorization: Token {{adminToken}}

################################################################################
# TICKET ASSIGNMENT (Manager/Admin)
################################################################################

### 20. Assign Ticket to Technician
# Replace {id} with actual ticket ID
# Technician must belong to ticket's section
PATCH {{baseUrl}}/api/tickets/1/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "assigned_to": 2,
  "status": "assigned"
}

### 21. Reassign Ticket to Another Technician
PATCH {{baseUrl}}/api/tickets/1/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "assigned_to": 3
}

################################################################################
# TICKET STATUS UPDATES (Technician)
################################################################################

### 22. Update Status: Assigned → In Progress
PATCH {{baseUrl}}/api/tickets/1/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "status": "in_progress"
}

### 23. Update Status: In Progress → Pending (with reason)
PATCH {{baseUrl}}/api/tickets/1/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "status": "pending",
  "pending_reason": "Waiting for replacement parts to arrive"
}

### 24. Update Status: Pending → In Progress (resume work)
PATCH {{baseUrl}}/api/tickets/1/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "status": "in_progress"
}

### 25. Update Status: In Progress → Resolved
PATCH {{baseUrl}}/api/tickets/1/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "status": "resolved",
  "resolution_notes": "Replaced faulty compressor unit. AC is now working properly."
}

### 26. Update Status: Resolved → Closed (Admin/Manager only)
PATCH {{baseUrl}}/api/tickets/1/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "status": "closed"
}

