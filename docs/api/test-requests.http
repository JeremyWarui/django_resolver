################################################################################
# COMPLETE WORKFLOW — STANDARD TICKET
# User → assign → in_progress → resolve → feedback → close
################################################################################

### STEP 1: User raises ticket
POST {{baseUrl}}/api/tickets/
Content-Type: {{contentType}}
Authorization: Token {{userToken}}

{
  "title": "Leaking Pipe in 2nd Floor Bathroom",
  "description": "Leak under the sink. Water pooling on the floor.",
  "section_id": 2,
  "facility_id": 3
}

###
### STEP 2: Admin views unassigned tickets
GET {{baseUrl}}/api/tickets/?assigned_to__isnull=true&status=open
Authorization: Token {{adminToken}}

###
### STEP 3: Assign to technician (replace {id} with ID from step 1)
PATCH {{baseUrl}}/api/tickets/{id}/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "assigned_to": 13,
  "status": "assigned"
}

###
### STEP 4: Technician starts work
PATCH {{baseUrl}}/api/tickets/{id}/
Content-Type: {{contentType}}
Authorization: Token {{technicianToken}}

{
  "status": "in_progress"
}

###
### STEP 5: Technician adds comment
POST {{baseUrl}}/api/tickets/{id}/comments/
Content-Type: {{contentType}}
Authorization: Token {{technicianToken}}

{
  "text": "Found a worn pipe fitting. Replacing it now."
}

###
### STEP 6: Technician resolves ticket
PATCH {{baseUrl}}/api/tickets/{id}/
Content-Type: {{contentType}}
Authorization: Token {{technicianToken}}

{
  "status": "resolved"
}

###
### STEP 7: User submits feedback
POST {{baseUrl}}/api/tickets/{id}/feedback/
Content-Type: {{contentType}}
Authorization: Token {{userToken}}

{
  "rating": 5,
  "comment": "Fast and professional. No more leak!"
}

###
### STEP 8: Admin closes ticket
POST {{baseUrl}}/api/tickets/{id}/close/
Authorization: Token {{adminToken}}

################################################################################
# COMPLETE WORKFLOW — APPROVAL REQUIRED
# Ticket starts as "pending_approval"; manager approves before work begins
################################################################################

### STEP 1: User raises ticket for service item that requires approval
POST {{baseUrl}}/api/tickets/
Content-Type: {{contentType}}
Authorization: Token {{userToken}}

{
  "title": "Office Furniture Replacement",
  "description": "Requesting replacement of 3 broken office chairs in Room 204.",
  "section_id": 3,
  "facility_id": 5,
  "service_item_id": 10
}

###
### STEP 2: Manager reviews pending_approval tickets
GET {{baseUrl}}/api/tickets/?status=pending_approval
Authorization: Token {{managerToken}}

###
### STEP 3: Manager approves (or rejects — see below)
POST {{baseUrl}}/api/tickets/{id}/approve/
Authorization: Token {{managerToken}}

###
### STEP 3 (alt): Manager rejects
POST {{baseUrl}}/api/tickets/{id}/reject/
Content-Type: {{contentType}}
Authorization: Token {{managerToken}}

{
  "reason": "Procurement freeze until end of quarter."
}

###
### STEP 4: After approval, admin assigns to technician
PATCH {{baseUrl}}/api/tickets/{id}/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "assigned_to": 13,
  "status": "assigned"
}

################################################################################
# ERROR SCENARIOS
################################################################################

### ERROR 1: Assign ticket to technician not in that section (expect 400)
PATCH {{baseUrl}}/api/tickets/6/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "assigned_to": 17
}

### ERROR 2: Invalid status transition — open → resolved (expect 400)
PATCH {{baseUrl}}/api/tickets/6/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "status": "resolved"
}

### ERROR 3: User tries to assign ticket (expect 403)
PATCH {{baseUrl}}/api/tickets/6/
Content-Type: {{contentType}}
Authorization: Token {{userToken}}

{
  "assigned_to": 12
}

### ERROR 4: pending status missing required fields (expect 400)
PATCH {{baseUrl}}/api/tickets/1/
Content-Type: {{contentType}}
Authorization: Token {{technicianToken}}

{
  "status": "pending"
}

### ERROR 5: Modify a closed ticket (expect 400)
PATCH {{baseUrl}}/api/tickets/4/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "status": "open"
}

### ERROR 6: Non-admin creates organization (expect 403)
POST {{baseUrl}}/api/organizations/
Content-Type: {{contentType}}
Authorization: Token {{hodToken}}

{
  "name": "Rogue Org",
  "code": "RGO",
  "organization_type": "other",
  "headquarters": "Somewhere"
}

### ERROR 7: Unauthenticated request (expect 401)
GET {{baseUrl}}/api/tickets/

################################################################################
# NOTES
################################################################################

# SETUP
# 1. Start dev server:       python manage.py runserver
# 2. Load fixture:           python manage.py loaddata tickets_initial_data --ignorenonexistent
# 3. Login for each role and copy the token into the @xxxToken variables above
# 4. Replace {id} placeholders with actual IDs from responses
# 5. Install the REST Client extension in VS Code

# ROLES
#   admin            → full access to everything
#   manager          → cross-campus, own-department scope
#   hod              → own department on own campus
#   head_of_section  → own section only; inherits technician permissions + assign
#   technician       → tickets in assigned sections
#   user             → own tickets only

# ANALYTICS ENDPOINTS BY ROLE
#   /api/analytics/admin-dashboard/  → admin
#   /api/analytics/manager/          → manager
#   /api/analytics/hod/              → hod
#   /api/analytics/section-head/     → head_of_section
#   /api/analytics/tickets/          → admin / manager (query params: timeframe, days, section_id)
#   /api/analytics/technicians/      → admin / manager (query param: technician_id)
#   /api/analytics/organizational/   → admin / manager

# TICKET STATUS MACHINE
#   open → assigned → in_progress → pending → resolved → closed
#   pending_approval → (approve) → open  |  (reject) → rejected
#   Transitions enforced server-side; invalid moves return 400.

# ESCALATION PRIORITY MAPPING
#   escalation_level 0 → priority "low"
#   escalation_level 1 → priority "medium"
#   escalation_level >= 2 → priority "high"
#   "critical" is set manually and is never downgraded automatically.

# ROLE-BASED FIELD STRIPPING
#   FacilitySerializer
#     purchase_date, warranty_expiry, asset_value  →  hod / manager / admin only
#   SectionSerializer
#     technicians                                  →  head_of_section / hod / admin only
#   TicketSerializer
#     available_technicians                        →  head_of_section / hod / admin only
#     escalation fields                            →  all except user (stripped)
#     organizational_path                          →  head_of_section / hod / manager / admin only

# SERVICE CATALOGUE (Phase 4)
#   /api/service-catalogue/department-types/      → list department type blueprints
#   /api/service-catalogue/section-types/<pk>/    → detail + default SLA
#   /api/service-catalogue/service-categories/    → list all categories
#   /api/service-catalogue/service-items/         → list all items (with form_schema)
#   /api/section-types/<pk>/categories/           → categories for a section type (wizard)
#   /api/categories/<pk>/items/                   → items for a category (wizard)
#   /api/service-items/<pk>/                      → single item + form_schema

# TROUBLESHOOTING
#   401 Unauthorized  → token invalid or expired; re-login
#   403 Forbidden     → role lacks permission for this action
#   404 Not Found     → ID does not exist or is out of scope for your role
#   400 Bad Request   → invalid field values or illegal status transition
