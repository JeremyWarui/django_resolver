################################################################################
# COMPLETE WORKFLOW EXAMPLE
################################################################################

### WORKFLOW 1: User Creates Ticket → Manager Assigns → Technician Resolves → User Provides Feedback

# Step 1: User creates a ticket
POST {{baseUrl}}/api/tickets/
Content-Type: {{contentType}}
Authorization: Token {{userToken}}

{
  "title": "Leaking Pipe in Bathroom",
  "description": "There's a leak under the sink in the 2nd floor bathroom",
  "section_id": 2,
  "facility_id": 1
}

###
# Step 2: Manager views unassigned tickets
GET {{baseUrl}}/api/tickets/?assigned_to__isnull=true&status=open
Authorization: Token {{adminToken}}

###
# Step 3: Manager assigns to technician (use ticket ID from step 1)
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "assigned_to": 2
}

###
# Step 4: Technician starts work
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "status": "in_progress"
}

###
# Step 5: Technician adds comment
POST {{baseUrl}}/api/comments/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "ticket": "{ticket_id}",
  "text": "Located the leak. Replacing the worn-out pipe fitting."
}

###
# Step 6: Technician resolves ticket
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "status": "resolved",
  "resolution_notes": "Replaced pipe fitting. Leak fixed. Tested for 30 minutes, no leaks detected."
}

###
# Step 7: User provides feedback
POST {{baseUrl}}/api/feedback/
Content-Type: {{contentType}}
Authorization: Token {{userToken}}

{
  "ticket": "{ticket_id}",
  "rating": 5,
  "comment": "Quick response and professional work. Thank you!"
}

###
# Step 8: Manager closes ticket
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "status": "closed"
}

################################################################################
# WORKFLOW 2: Pending Status Workflow
################################################################################

### Scenario: Technician needs parts, puts ticket on pending

# Step 1: Technician marks as pending
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "status": "pending",
  "pending_reason": "Waiting for specialized tool from equipment room"
}

###
# Step 2: User adds comment asking for update
POST {{baseUrl}}/api/comments/
Content-Type: {{contentType}}
Authorization: Token {{userToken}}

{
  "ticket": "{ticket_id}",
  "text": "Any update on when this will be completed?"
}

###
# Step 3: Technician responds
POST {{baseUrl}}/api/comments/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "ticket": "{ticket_id}",
  "text": "Parts arrived. Will resume work tomorrow morning."
}

###
# Step 4: Technician resumes work
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "status": "in_progress"
}

################################################################################
# ERROR SCENARIOS (Testing Validation)
################################################################################

### ERROR 1: Try to assign ticket to technician from wrong section
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "assigned_to": 99
}

### ERROR 2: Try to submit feedback on unresolved ticket
POST {{baseUrl}}/api/feedback/
Content-Type: {{contentType}}
Authorization: Token {{userToken}}

{
  "ticket": "{open_ticket_id}",
  "rating": 5,
  "comment": "This should fail"
}

### ERROR 3: Try invalid status transition (open → resolved)
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "status": "resolved"
}

### ERROR 4: User tries to assign ticket (permission denied)
PATCH {{baseUrl}}/api/tickets/{ticket_id}/
Content-Type: {{contentType}}
Authorization: Token {{userToken}}

{
  "assigned_to": 2
}

### ERROR 5: Try to modify closed ticket
PATCH {{baseUrl}}/api/tickets/{closed_ticket_id}/
Content-Type: {{contentType}}
Authorization: Token {{adminToken}}

{
  "status": "open"
}

################################################################################
# NOTES & SETUP
################################################################################

# Before running these tests:
# 1. Start the Django development server: python manage.py runserver
# 2. Load fixture data: python manage.py loaddata tickets/fixtures/tickets_initial_data_org.json
# 3. Get an admin token: Use "Login as Admin Example" test first, copy token to @adminToken variable
# 4. Update @userToken, @technicianToken, @managerToken by logging in with their credentials
# 5. Replace {ticket_id}, {user_id}, etc. with actual IDs from responses
# 6. Install REST Client extension in VS Code

# Using REST Client Extension:
# - Click "Send Request" link above each request to execute
# - View responses in the right panel
# - Results show status code, headers, and formatted JSON body
# - Use Ctrl+Alt+E (Windows/Linux) or Cmd+Alt+E (Mac) to send requests
# - Store tokens in @variable format at top to reuse across multiple requests

# Authentication:
# - DRF Token Auth format: Authorization: Token your_token_here
# - All endpoints require a valid token in the Authorization header
# - Get token from /api/auth/login/ endpoint by posting username + password

# ESCALATION PRIORITY FEATURE:
# The new feature automatically sets ticket priority based on escalation level:
#   - Escalation Level 0 (no escalation) → priority = "low"
#   - Escalation Level 1 (escalated to section head) → priority = "medium"
#   - Escalation Level 2 (escalated to HOD) → priority = "high"
# 
# Test this feature using the "PRIORITY TEST 1-4" requests in the 
# "ESCALATION PRIORITY TESTS" section above.

# Troubleshooting:
# - 401 Unauthorized: Check token validity, re-login
# - 403 Forbidden: Check user permissions for the role
# - 404 Not Found: Verify ticket/comment ID exists in database
# - 400 Bad Request: Check request body format and required fields
